# PostgreSQL (pgvector)
POSTGRES_DB=vektryn
POSTGRES_USER=vektryn
POSTGRES_PASSWORD=vektryn_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vektryn:vektryn_dev_password@postgres:5432/vektryn

# Redis
REDIS_URL=redis://redis:6379/0

# Apache Kafka (KRaft)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Django Control Plane
DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,control-plane

# Gemini API (Platform key used ONLY by enrichment-worker; user AI features use per-user BYOK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_ENRICHMENT_MODEL=gemini-3.5-flash-lite
GEMINI_ENRICHMENT_FALLBACK_MODEL=gemini-3.8-flash
ENRICHMENT_DAILY_CAP=250

# Fernet symmetric key (urlsafe base64 of 32 random bytes) for encrypting user BYOK Gemini API keys
# Generate with: openssl rand -base64 32 | tr '+/' '-_'
BYOK_ENCRYPTION_KEY=

# Storage (local mode for v0.1 dev, gcs for GCP)
STORAGE_BACKEND=local
GCS_BUCKET_RAW_HTML=vektryn-raw-html
GCS_BUCKET_RESUMES=vektryn-resumes

# Optional Sentry Error Monitoring (zero-op when blank)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=
VITE_SENTRY_DSN=