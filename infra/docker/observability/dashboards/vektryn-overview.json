{
  "uid": "vektryn-overview",
  "title": "Vektryn Pipeline Overview",
  "tags": ["vektryn", "kafka", "gemini", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets Up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(up)",
          "legendFormat": "Up"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active SSE Clients",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(vektryn_sse_active_clients) or vector(0)",
          "legendFormat": "SSE Clients"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Jobs Ingested (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(vektryn_ingest_jobs_total[1h])) or vector(0)",
          "legendFormat": "Ingested"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Match Alerts Emitted (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(vektryn_match_alerts_emitted_total[1h])) or vector(0)",
          "legendFormat": "Alerts"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Job Ingest Rate by ATS Source",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (ats_source) (rate(vektryn_ingest_jobs_total[5m]))",
          "legendFormat": "{{ats_source}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Kafka Worker Throughput & DLQ Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (worker, outcome) (rate(vektryn_worker_messages_total[5m]))",
          "legendFormat": "{{worker}} ({{outcome}})"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Gemini API p95 Latency (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(vektryn_gemini_latency_seconds_bucket[5m])))",
          "legendFormat": "{{operation}} p95"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Gemini API Calls (Success vs Error)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (operation, status) (rate(vektryn_gemini_calls_total[5m]))",
          "legendFormat": "{{operation}} [{{status}}]"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Worker Message Processing p95 Duration (s)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, worker) (rate(vektryn_worker_processing_seconds_bucket[5m])))",
          "legendFormat": "{{worker}} p95"
        }
      ]
    }
  ]
}
