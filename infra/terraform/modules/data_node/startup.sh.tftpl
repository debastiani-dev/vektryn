#!/usr/bin/env bash
set -euo pipefail

# 1. Configure 2 GB swapfile (critical for e2-micro Always-Free 1 GB RAM)
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# 2. Install Docker + Compose plugin if missing
if ! command -v docker >/dev/null 2>&1; then
  apt-get update -y
  apt-get install -y ca-certificates curl gnupg python3
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg
  echo \
    "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian \
    $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
    > /etc/apt/sources.list.d/docker.list
  apt-get update -y
  apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
  systemctl enable --now docker
fi

mkdir -p /opt/vektryn

# 3. Fetch runtime secrets from GCP Secret Manager via VM service account (zero secrets in TF state)
fetch_secret() {
  local secret_name="$1"
  local token
  token=$(curl -sf -H "Metadata-Flavor: Google" \
    "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
    | python3 -c "import json,sys; print(json.load(sys.stdin)['access_token'])")
  curl -sf -H "Authorization: Bearer $token" \
    "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/$secret_name/versions/latest:access" \
    | python3 -c "import base64,json,sys; print(base64.b64decode(json.load(sys.stdin)['payload']['data']).decode('utf-8').strip())"
}

# Authenticate Docker to Artifact Registry using VM metadata token
ACCESS_TOKEN=$(curl -sf -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
  | python3 -c "import json,sys; print(json.load(sys.stdin)['access_token'])")
echo "$ACCESS_TOKEN" | docker login -u oauth2accesstoken --password-stdin "https://${region}-docker.pkg.dev"

DATABASE_URL=$(fetch_secret "vektryn-database-url")
GEMINI_API_KEY=$(fetch_secret "vektryn-gemini-api-key")
INGEST_API_KEY=$(fetch_secret "vektryn-ingest-api-key")
STREAM_AUTH_SECRET=$(fetch_secret "vektryn-stream-auth-secret")
SENTRY_DSN=$(fetch_secret "vektryn-sentry-dsn" 2>/dev/null || true)

POSTGRES_PASSWORD=$(python3 -c "from urllib.parse import unquote, urlparse; import sys; print(unquote(urlparse(sys.argv[1]).password or 'vektryn_prod'))" "$DATABASE_URL")
POSTGRES_USER=$(python3 -c "from urllib.parse import unquote, urlparse; import sys; print(unquote(urlparse(sys.argv[1]).username or 'vektryn'))" "$DATABASE_URL")
POSTGRES_DB=$(python3 -c "from urllib.parse import urlparse; import sys; print(urlparse(sys.argv[1]).path.lstrip('/') or 'vektryn')" "$DATABASE_URL")

cat > /opt/vektryn/.env <<EOF
POSTGRES_USER=$POSTGRES_USER
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
POSTGRES_DB=$POSTGRES_DB
DATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/$POSTGRES_DB
GEMINI_API_KEY=$GEMINI_API_KEY
INGEST_API_KEY=$INGEST_API_KEY
STREAM_AUTH_SECRET=$STREAM_AUTH_SECRET
STORAGE_BACKEND=gcs
GCS_SNAPSHOTS_BUCKET=${snapshots_bucket_name}
SENTRY_DSN=$SENTRY_DSN
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
EOF
chmod 600 /opt/vektryn/.env

cat > /opt/vektryn/init.sql <<'EOF'
CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS pgcrypto;
EOF

cat > /opt/vektryn/docker-compose.yml <<EOF
services:
  postgres:
    image: pgvector/pgvector:pg17
    container_name: vektryn-postgres
    restart: unless-stopped
    command: ["postgres", "-c", "shared_buffers=128MB", "-c", "max_connections=50"]
    env_file: [.env]
    ports:
      - "${internal_ip}:5432:5432"
      - "127.0.0.1:5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./init.sql:/docker-entrypoint-initdb.d/01-init.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \$\$POSTGRES_USER -d \$\$POSTGRES_DB"]
      interval: 5s
      timeout: 5s
      retries: 10

  redis:
    image: redis:7-alpine
    container_name: vektryn-redis
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes", "--maxmemory", "64mb", "--maxmemory-policy", "allkeys-lru"]
    ports:
      - "${internal_ip}:6379:6379"
      - "127.0.0.1:6379:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10

  kafka:
    image: apache/kafka:3.9.0
    container_name: vektryn-kafka
    restart: unless-stopped
    ports:
      - "${internal_ip}:9092:9092"
    environment:
      KAFKA_HEAP_OPTS: "-Xmx256M -Xms128M"
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://:9092,INTERNAL://:29092,CONTROLLER://:9093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://${internal_ip}:9092,INTERNAL://kafka:29092
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,INTERNAL:PLAINTEXT
      KAFKA_INTER_BROKER_LISTENER_NAME: INTERNAL
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:9093
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "true"
      CLUSTER_ID: MkU3OEVBNTcwNTJENDM2Qk
    volumes:
      - kafka_data:/var/lib/kafka/data
    healthcheck:
      test: ["CMD-SHELL", "nc -z 127.0.0.1 29092"]
      start_period: 45s
      interval: 10s
      timeout: 5s
      retries: 20

  kafka-init:
    image: apache/kafka:3.9.0
    container_name: vektryn-kafka-init
    depends_on:
      kafka:
        condition: service_healthy
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka:29092 --create --if-not-exists --topic jobs.raw --partitions 3 --replication-factor 1
        /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka:29092 --create --if-not-exists --topic jobs.enriched --partitions 3 --replication-factor 1
        /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka:29092 --create --if-not-exists --topic jobs.rescore --partitions 3 --replication-factor 1
        /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka:29092 --create --if-not-exists --topic jobs.alerts --partitions 3 --replication-factor 1
        /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka:29092 --create --if-not-exists --topic jobs.dlq --partitions 1 --replication-factor 1

  enrichment-worker:
    image: ${stream_edge_latest_image}
    container_name: vektryn-enrichment-worker
    restart: unless-stopped
    command: ["python", "-m", "stream_edge.workers.enrichment"]
    env_file: [.env]
    environment:
      REDIS_URL: redis://redis:6379/0
      KAFKA_BOOTSTRAP_SERVERS: kafka:29092
    depends_on:
      redis:
        condition: service_healthy
      kafka-init:
        condition: service_completed_successfully

  matcher-worker:
    image: ${stream_edge_latest_image}
    container_name: vektryn-matcher-worker
    restart: unless-stopped
    command: ["python", "-m", "stream_edge.workers.matcher"]
    env_file: [.env]
    environment:
      REDIS_URL: redis://redis:6379/0
      KAFKA_BOOTSTRAP_SERVERS: kafka:29092
    depends_on:
      postgres:
        condition: service_healthy
      kafka-init:
        condition: service_completed_successfully

volumes:
  postgres_data:
  redis_data:
  kafka_data:
EOF

cd /opt/vektryn
docker compose pull enrichment-worker matcher-worker || true
docker compose up -d
